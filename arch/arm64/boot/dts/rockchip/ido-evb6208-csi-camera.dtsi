/ {
	vcc_mipicsi0: vcc-mipicsi0-regulator {
		compatible = "regulator-fixed";
		// gpio = <&gpio3 RK_PC4 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		// pinctrl-0 = <&mipicsi0_pwr>;
		regulator-name = "vcc_mipicsi0";
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc_mipicsi1: vcc-mipicsi1-regulator {
		compatible = "regulator-fixed";
		// gpio = <&gpio3 RK_PC7 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		// pinctrl-0 = <&mipicsi1_pwr>;
		regulator-name = "vcc_mipicsi1";
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};
};

&csi2_dphy3 {
	status = "disabled";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			csi_dphy_input2: endpoint@2 {
				reg = <1>;
				remote-endpoint = <&sc450ai_out>;
				data-lanes = <1 2>;
			};

			mipi_in_ucam0: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&sc850sl_out0>;
				data-lanes = <1 2 3 4>;
			};

			ov13855_in_ucam0: endpoint@3 {
				reg = <1>;
				remote-endpoint = <&ov13855_out0>;
				data-lanes = <1 2 3 4>;
			};
		};
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csidphy0_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi2_csi2_input>;
			};
		};
	};
};

&csi2_dphy0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_in_ucam1: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&ov13855_out1>;
				data-lanes = <1 2 3 4>;
			};
		};
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csidphy3_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi0_csi2_input>;
			};
		};
	};
};

&i2c3 {
	status = "okay";
	pinctrl-0 = <&i2c3m0_xfer>;
	
	dw9714: dw9714@c {
		compatible = "dongwoon,dw9714";
		status = "disabled";
		reg = <0x0c>;
		rockchip,vcm-start-current = <10>;
		rockchip,vcm-rated-current = <85>;
		rockchip,vcm-step-mode = <5>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "fornt";
	};
/*
	gc8034: gc8034@37 {
		compatible = "galaxycore,gc8034";
		reg = <0x37>;
		clocks = <&cru CLK_CAM3_OUT2IO>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk3_out>;
		reset-gpios = <&gpio3 RK_PC7 GPIO_ACTIVE_LOW>;
		pwdn-gpios = <&gpio3 RK_PD0 GPIO_ACTIVE_LOW>;
		// dvdd-supply = <&vcc_mipicsi0>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "RK-CMK-8M-2-v1";
		rockchip,camera-module-lens-name = "CK8401";
		lens-focus = <&dw9714>;
		status = "disabled";
		port {
			gc8034_out0: endpoint {
				remote-endpoint = <&mipi_in_ucam0>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
*/
	sc450ai: sc450ai@30 {
		compatible = "smartsens,sc450ai";
		status = "disabled";
		reg = <0x30>;
		//clocks = <&cru CLK_MIPI0_OUT2IO>;
		clocks = <&cru CLK_CAM0_OUT2IO>;
		clock-names = "xvclk";
		//reset-gpios = <&gpio3 RK_PB3 GPIO_ACTIVE_HIGH>;
		//pwdn-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		// pinctrl-0 = <&cam_clk0_pins>;
		pinctrl-0 = <&camm0_clk1_out>;
		reset-gpios = <&gpio3 RK_PC2 GPIO_ACTIVE_HIGH>;
		pwdn-gpios = <&gpio3 RK_PC3 GPIO_ACTIVE_HIGH>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "default";
		rockchip,camera-module-lens-name = "default";
		//rockchip,camera-module-sync-mode = "internal_master";
		port {
			sc450ai_out: endpoint {
				remote-endpoint = <&csi_dphy_input2>;
				data-lanes = <1 2>;
			};
		};
	};

	sc850sl_0: sc850sl@30 {
		status = "disabled";
		// compatible = "ovti,ov13855";
		compatible = "smartsens,sc850sl";
		reg = <0x30>;
		clocks = <&cru CLK_CAM1_OUT2IO>;
		clock-names = "xvclk";
		//pinctrl-names = "rockchip,camera_default";
		pinctrl-names = "default";
		pinctrl-0 = <&camm0_clk1_out>;
		reset-gpios = <&gpio3 RK_PC2 GPIO_ACTIVE_HIGH>;
		pwdn-gpios = <&gpio3 RK_PC3 GPIO_ACTIVE_HIGH>;

		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "default";
		rockchip,camera-module-lens-name = "default";
//		lens-focus = <&dw9714>;

		port {
			sc850sl_out0: endpoint {
				remote-endpoint = <&mipi_in_ucam0>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	ov13855_0: ov13855@36 {
		status = "disabled";
		compatible = "ovti,ov13855";
		reg = <0x36>;
		clocks = <&cru CLK_CAM3_OUT2IO>;
		//clocks = <&cru CLK_CAM0_OUT2IO>;
		clock-names = "xvclk";
		//pinctrl-names = "rockchip,camera_default";
		pinctrl-names = "default";
		pinctrl-0 = <&camm0_clk1_out>;
		reset-gpios = <&gpio3 RK_PC2 GPIO_ACTIVE_HIGH>;
		pwdn-gpios = <&gpio3 RK_PC3 GPIO_ACTIVE_HIGH>;

		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "KYT-10203-v1";
		rockchip,camera-module-lens-name = "default";
		lens-focus = <&dw9714>;

		port {
			ov13855_out0: endpoint {
				remote-endpoint = <&ov13855_in_ucam0>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
	
	
};

&i2c4 {
	status = "okay";
	pinctrl-0 = <&i2c4m0_xfer>;

	dw9763: dw9763@c {
		compatible = "dongwoon,dw9763";
		status = "okay";
		reg = <0x0c>;
		rockchip,vcm-max-current = <120>;
		rockchip,vcm-start-current = <20>;
		rockchip,vcm-rated-current = <90>;
		rockchip,vcm-step-mode = <3>;
		rockchip,vcm-t-src = <0x20>;
		rockchip,vcm-t-div = <1>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
	};

	ov13855_1: ov13855@36 {
		status = "okay";
		compatible = "ovti,ov13855";
		reg = <0x36>;
		clocks = <&cru CLK_CAM0_OUT2IO>;
		clock-names = "xvclk";
		//pinctrl-names = "rockchip,camera_default";
		pinctrl-names = "default";
		pinctrl-0 = <&camm0_clk0_out>;

		reset-gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
		pwdn-gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_HIGH>;

		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "default";
		rockchip,camera-module-lens-name = "default";
		lens-focus = <&dw9763>;

		port {
			ov13855_out1: endpoint {
				remote-endpoint = <&mipi_in_ucam1>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

&csi2_dphy0_hw {
	status = "okay";
};

&csi2_dphy1_hw {
	status = "okay";
};

&mipi0_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi0_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csidphy0_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi0_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi_in0>;
			};
		};
	};
};

&mipi2_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi2_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csidphy3_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi2_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi_in1>;
			};
		};
	};
};

&rkcif {
	status = "okay";
};

&rkcif_mipi_lvds {
	status = "okay";

	port {
		cif_mipi_in0: endpoint {
			remote-endpoint = <&mipi0_csi2_output>;
		};
	};
};

&rkcif_mipi_lvds2 {
	status = "okay";

	port {
		cif_mipi_in1: endpoint {
			remote-endpoint = <&mipi2_csi2_output>;
		};
	};
};

&rkcif_mipi_lvds_sditf {
	status = "okay";

	port {
		mipi_lvds_sditf: endpoint {
			remote-endpoint = <&isp_vir0>;
		};
	};
};

&rkcif_mipi_lvds2_sditf {
	status = "okay";

	port {
		mipi_lvds2_sditf: endpoint {
			remote-endpoint = <&isp_vir1>;
		};
	};
};

&rkcif_mmu {
	status = "okay";
};

&rkisp {
	status = "okay";
};

&rkisp_mmu {
	status = "okay";
};

&rkisp_vir0 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp_vir0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi_lvds_sditf>;
		};
	};
};

&rkisp_vir1 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp_vir1: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&mipi_lvds2_sditf>;
		};
	};
};

&pinctrl {
	cam {
		mipicsi0_pwr: mipicsi0-pwr {
			rockchip,pins =
				/* camera power en */
				<3 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		mipicsi1_pwr: mipicsi1-pwr {
			rockchip,pins =
				/* camera1 power en */
				<3 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};


